# Môi trường chạy ứng dụng
NODE_ENV=development

# Cổng chạy Backend API
PORT=5000

# Base URL của API (chỉ dùng cho development)
# Production: https://study_schedule_lms.quangde.cloud/api (tự động khi NODE_ENV=production)
API_URL=http://localhost:5000/api

# Chuỗi kết nối MongoDB
# Local:  mongodb://localhost:27017/study_schedule_lms
# Atlas:  mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/study_schedule_lms?retryWrites=true&w=majority
# VPS:    mongodb://admin:<password>@<ip>:27017/study_schedule_lms?authSource=admin
DATABASE_URL=mongodb://localhost:27017/study_schedule_lms

# Secret key để mã hóa JWT Token (tạo bằng: openssl rand -hex 32)
JWT_SECRET=your_super_secret_key_here
